# Copier ce fichier en .env puis renseigner les valeurs.
#
#     cp .env.exemple .env
#
# Attention : docker compose lit ce fichier avec un parseur strict.
# Ni apostrophes ni guillemets, meme dans les commentaires.
# Les explications sont dans le README.

# Jeton GenIAL. Obligatoire avec le moteur genial.
GENIAL_TOKEN=

# Moteur : local ou genial
MEETING_MOTEUR=genial

# Mode : auto, direct ou differe
# differe = un seul appel a l API par reunion
MEETING_MODE=differe

# Modele de redaction du compte rendu.
# Laisser vide pour ne faire que de la transcription.
# Pour connaitre les noms disponibles :
#   docker compose exec meeting-ct python diag_genial.py
MEETING_MODELE=

# Cle exigee sur la route d integration /api/reunions/{ref}.
# Laisser vide en local. A definir des que le serveur est joignable
# depuis une autre machine. Voir docs/INTEGRATION.md
MEETING_CLE_API=

# Certificat TLS, pour servir en HTTPS.
# Laisser vide pour servir en HTTP : cela ne marche que sur localhost,
# car les navigateurs refusent le micro hors HTTPS.
# Pour generer un certificat de test : python genere_certificat.py
MEETING_SSL_CERT=
MEETING_SSL_KEY=
